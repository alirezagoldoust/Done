# Copy to backend/.env and adjust as needed. Do not commit real secrets.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — defaults to a local SQLite file when unset.
# For Postgres later: DATABASE_URL=postgres://user:pass@localhost:5432/taskmanager
# DATABASE_URL=

# CORS / CSRF — the Next.js dev server origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
